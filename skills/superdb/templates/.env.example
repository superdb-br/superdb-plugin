# SuperDB — variáveis do projeto. Pegue os valores no dashboard:
# app.superdb.com.br → seu projeto → Connect (ou aba API).

# Host de auth (login/cadastro). É o mesmo pra todos os projetos.
SUPERDB_AUTH_URL=https://auth.superdb.com.br

# Host de dados (REST). Derivado automático se você não setar (auth.* -> api.*).
# SUPERDB_API_URL=https://api.superdb.com.br

# Slug do seu projeto (vira o schema proj_<slug> e o header Accept-Profile).
SUPERDB_PROJECT=meu_projeto

# anon key — PÚBLICA (pode ir no frontend/app). Respeita as políticas RLS.
SUPERDB_ANON_KEY=cole_a_anon_key_aqui

# service_role key — SECRETA, só no backend. NUNCA no frontend/app/mobile.
# SUPERDB_SERVICE_ROLE_KEY=...
